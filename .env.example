# Copy to .env and replace the required values before running.
# Copy to .env. Process environment variables override .env values.
# URL contains driver, host, port and database name, WITHOUT credentials.
DATABASE_URL=postgresql+psycopg://postgres:5432/smsbot
DATABASE_USER=smsbot
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# For remote databases, configure TLS to match the database provider.
# Example: append ?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem

# Generate independent secrets during deployment. Never use these placeholders.
APP_SECRET=REPLACE_WITH_RANDOM_APP_SECRET
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_ENCRYPTION_KEY

# Local development: frontend is at http://localhost:5173.
# Production: set the public HTTPS origin and COOKIE_SECURE=true.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DEVICE_POLL_MS=1000
DEVICE_HEARTBEAT_MS=30000
# Explicitly enable only when notifications target your own private services.
ALLOW_PRIVATE_NOTIFICATIONS=false
